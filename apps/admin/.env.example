# Application
NEXT_PUBLIC_APP_NAME=Nova Admin
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_DEFAULT_LOCALE=en

# API — same backend apps/web talks to.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# O-2 — error tracking (src/instrumentation.ts, src/instrumentation-client.ts).
# Get a DSN from Sentry (Settings -> Projects -> nova-admin -> Client Keys) or
# leave blank to disable Sentry entirely. A DSN isn't a secret — it's meant to
# ship in client-side JS — so the same value covers server, edge, and browser.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
