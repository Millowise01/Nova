# Local Postgres — matches the "postgres" service in docker-compose.yml at the repo root
# (`docker compose up -d`), a standard Postgres connection URL (scheme, user, password,
# host, port, database name). Default docker-compose credentials: user nova, password
# nova_dev_password, port 5433, database nova. Left blank here, not filled in, so this
# file never contains a value that reads as a real connection string.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

PORT=4000
NODE_ENV=development

# JWT — RS256 is the confirmed target (see backend/docs/05-security-baseline.md) but this
# pass uses HS256 shared secrets for simplicity; rotate to RS256 keypairs before Phase 2.
JWT_ACCESS_SECRET=replace_with_a_long_random_dev_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_dev_secret
JWT_REFRESH_EXPIRY=30d

# AES-256-GCM key for field-level PII encryption (Vol 2, D3) — 32 bytes, base64-encoded.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NON-PRODUCTION KEY MANAGEMENT — confirmed decision (backend/docs/08-security-implementation-checklist.md):
# this is a local, developer-generated key, NOT a managed KMS. Vol 3, D2 requires a real
# KMS in production; this key must be rotated out and replaced before any real deployment
# — it exists only to unblock Phase 1 application work ahead of a cloud/KMS decision.
PII_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# CORS — comma-separated allowlist, never "*" (Vol 3, C1). Defaults to the local web app.
CORS_ALLOWED_ORIGINS=http://localhost:3000
