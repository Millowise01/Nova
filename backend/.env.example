# Local Postgres — matches the "postgres" service in docker-compose.yml at the repo root
# (`docker compose up -d`), a standard Postgres connection URL (scheme, user, password,
# host, port, database name). Default docker-compose credentials: user nova, password
# nova_dev_password, port 5433, database nova. Left blank here, not filled in, so this
# file never contains a value that reads as a real connection string.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

PORT=4000
NODE_ENV=development

# JWT — RS256 asymmetric keypair (backend/docs/05-security-baseline.md): access tokens are
# signed with the private key and verified with the public key alone, so any future module
# or extracted microservice never needs to hold the signing secret. Both values are PEM,
# base64-encoded so they survive as a single-line .env value. Generate a dev keypair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_ACCESS_PRIVATE_KEY='+Buffer.from(privateKey).toString('base64'));console.log('JWT_ACCESS_PUBLIC_KEY='+Buffer.from(publicKey).toString('base64'));"
JWT_ACCESS_PRIVATE_KEY=replace_with_a_base64_encoded_pkcs8_pem_private_key
JWT_ACCESS_PUBLIC_KEY=replace_with_a_base64_encoded_spki_pem_public_key
JWT_ACCESS_EXPIRY=15m
# The refresh token is NOT a JWT (see token.service.ts) — it's a high-entropy opaque value
# whose hash is stored server-side, so there is no JWT_REFRESH_SECRET to configure.
JWT_REFRESH_EXPIRY=30d

# AES-256-GCM key for field-level PII encryption (Vol 2, D3) — 32 bytes, base64-encoded.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NON-PRODUCTION KEY MANAGEMENT — confirmed decision (backend/docs/08-security-implementation-checklist.md):
# this is a local, developer-generated key, NOT a managed KMS. Vol 3, D2 requires a real
# KMS in production; this key must be rotated out and replaced before any real deployment
# — it exists only to unblock Phase 1 application work ahead of a cloud/KMS decision.
PII_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# CORS — comma-separated allowlist, never "*" (Vol 3, C1). All three local frontend
# apps that talk to this backend: web (3000), seller (3001), admin (3002). Only web
# was listed until apps/seller's Phase 2 build — a real, previously-undiscovered gap
# that silently broke every browser-based (not MSW-mocked) request from apps/seller
# with a CORS preflight failure, only surfaced by that app's first real Playwright
# E2E run. apps/admin likely has the same latent gap; not fixed here (out of scope
# for an apps/seller pass), but worth checking before admin's own E2E test exists.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# O-1 — structured logging (backend/src/common/logging/). Leave at "info" in
# every real environment; only ever raised locally to debug a specific issue.
LOG_LEVEL=info

# O-2 — error tracking (backend/src/instrument.ts). Get a DSN from Sentry
# (Settings -> Projects -> nova-backend -> Client Keys) or leave blank to
# disable Sentry entirely — instrument.ts only calls Sentry.init() when this
# is set, so a blank value here is a real, supported "off" state, not a
# placeholder waiting to be filled in.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# O-3 — /metrics protection (backend/src/common/metrics/metrics-auth.guard.ts).
# Set to a random secret of at least 32 characters and scrapers must send
# "Authorization: Bearer <token>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left blank: /metrics is open in development/test and DISABLED (404) in production.
METRICS_TOKEN=
