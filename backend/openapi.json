{
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/signup": {
      "post": {
        "operationId": "AuthController_signup",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 7
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "confirmPassword": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "firstName",
                  "lastName",
                  "email",
                  "phone",
                  "password",
                  "confirmPassword"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["refreshToken"]
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp": {
      "post": {
        "operationId": "AuthController_requestOtp",
        "parameters": [],
        "responses": {
          "202": {
            "description": ""
          }
        },
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destination": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "email"
                      },
                      {
                        "type": "string",
                        "minLength": 7
                      }
                    ]
                  }
                },
                "required": ["destination"]
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/verify": {
      "post": {
        "operationId": "AuthController_verifyOtp",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destination": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "email"
                      },
                      {
                        "type": "string",
                        "minLength": 7
                      }
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                },
                "required": ["destination", "code"]
              }
            }
          }
        }
      }
    },
    "/v1/categories": {
      "post": {
        "operationId": "CatalogController_createCategory",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["catalog"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "parentId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": ["name", "slug"]
              }
            }
          }
        }
      }
    },
    "/v1/brands": {
      "post": {
        "operationId": "CatalogController_createBrand",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["catalog"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  }
                },
                "required": ["name", "slug"]
              }
            }
          }
        }
      }
    },
    "/v1/products": {
      "post": {
        "operationId": "CatalogController_createProduct",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["catalog"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "categoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "brandId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "priceAmount": {
                          "type": "string",
                          "pattern": "^\\d+(\\.\\d{1,2})?$"
                        },
                        "priceCurrency": {
                          "type": "string",
                          "enum": ["SLE", "USD"]
                        },
                        "stockQuantity": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["sku", "name", "priceAmount", "priceCurrency", "stockQuantity"]
                    },
                    "minItems": 1
                  }
                },
                "required": ["categoryId", "title", "slug", "variants"]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "CatalogController_listProducts",
        "parameters": [
          {
            "name": "cursor",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["catalog"]
      }
    },
    "/v1/products/{slug}": {
      "get": {
        "operationId": "CatalogController_getProduct",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["catalog"]
      }
    },
    "/v1/cart": {
      "post": {
        "operationId": "CartController_createCart",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["cart-checkout"]
      }
    },
    "/v1/cart/{cartId}": {
      "get": {
        "operationId": "CartController_getCart",
        "parameters": [
          {
            "name": "cartId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["cart-checkout"]
      }
    },
    "/v1/cart/{cartId}/lines": {
      "post": {
        "operationId": "CartController_addLine",
        "parameters": [
          {
            "name": "cartId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["cart-checkout"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variantId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  }
                },
                "required": ["variantId", "quantity"]
              }
            }
          }
        }
      }
    },
    "/v1/carts/{cartId}/checkout/session": {
      "post": {
        "operationId": "CartController_createCheckoutSession",
        "parameters": [
          {
            "name": "cartId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["cart-checkout"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "addressLine": {
                    "type": "string",
                    "minLength": 3
                  },
                  "city": {
                    "type": "string",
                    "minLength": 2
                  },
                  "district": {
                    "type": "string",
                    "minLength": 2
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 7
                  },
                  "deliveryMethod": {
                    "type": "string",
                    "enum": ["standard", "express", "pickup"]
                  },
                  "paymentMethod": {
                    "type": "string",
                    "enum": ["wallet", "card", "mobile-money"]
                  },
                  "promoCode": {
                    "type": "string"
                  }
                },
                "required": [
                  "addressLine",
                  "city",
                  "district",
                  "phone",
                  "deliveryMethod",
                  "paymentMethod"
                ]
              }
            }
          }
        }
      }
    },
