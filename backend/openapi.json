      "post": {
        "operationId": "WalletController_proposeRefund",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["payments-wallet"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentIntentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["paymentIntentId", "amount", "reason"]
              }
            }
          }
        }
      }
    },
    "/v1/wallet/refunds/{id}/approve": {
      "patch": {
