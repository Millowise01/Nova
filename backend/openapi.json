          "201": {
            "description": ""
          }
        },
        "tags": ["catalog"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "categoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "brandId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "description": {
                    "type": "string"
                  },
                  "isFeatured": {
                    "type": "boolean"
                  },
                  "isFlashSale": {
                    "type": "boolean"
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "priceAmount": {
                          "type": "string",
                          "pattern": "^\\d+(\\.\\d{1,2})?$"
                        },
                        "priceCurrency": {
                          "type": "string",
                          "enum": ["SLE", "USD"]
                        },
                        "stockQuantity": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": ["sku", "name", "priceAmount", "priceCurrency", "stockQuantity"]
                    },
                    "minItems": 1
                  }
                },
                "required": ["categoryId", "title", "slug", "variants"]
              }
