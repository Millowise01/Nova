// Nova backend — Phase 1 schema (Identity, Catalog, Cart & Checkout, Orders only).
// Conventions per backend/docs/03-database-conventions.md:
//   - snake_case tables/columns, PascalCase singular Prisma models
//   - every table: created_at/updated_at/created_by/updated_by, deleted_at (soft delete)
//   - country_code on every org-scoped table
//   - Money = numeric(14,2) + currency code, never float
//   - NO @relation across bounded-context boundaries — a field like `sellerId` on Product
//     is a plain scalar column (opaque reference to Identity's User), never a Prisma
//     @relation, because a @relation would generate a real FK constraint and that would
//     be exactly the direct cross-module table dependency backend/docs/00 prohibits.
//     @relation is only used WITHIN a single bounded context below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY
// ============================================================

model User {
  id             String   @id @default(uuid())
  emailEncrypted String   @map("email_encrypted")
  emailHash      String   @unique @map("email_hash")
  phoneEncrypted String?  @map("phone_encrypted")
  phoneHash      String?  @unique @map("phone_hash")
  // Nullable — existing rows predate this column, and it's not part of the
  // POST /v1/auth/signup contract's persisted fields being retrofitted here
  // (register() now sets it from firstName+lastName — see AuthService).
  name           String?
  // Profile/Settings scope only — GET/PATCH /v1/me deliberately never touches
  // email/phone (those need their own verify-then-change flow, not built here).
  locale         String   @default("en")
  roles          String[] @default(["customer"])
  countryCode    String   @default("SL") @map("country_code")
  // MFA enforcement gate (Vol 3, B1: mandatory for seller/admin, optional for customers).
  // Actual TOTP enrollment/challenge flow is out of scope this pass — this flag is the
  // extension point: once real MFA setup exists, enabling it flips this to true, and the
  // login-time gate (already enforced — see AuthService) starts allowing seller/admin
  // logins instead of blocking them.
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  // Vol 3, B4 "seller suspension" (backend/docs/10) — toggled through Trust & Safety's
  // dual-authorized propose/confirm flow, never written directly by any other module.
  // Checked by Catalog's createProduct (a suspended seller can't list new products);
  // existing listings aren't touched by this flag alone.
  sellerSuspended Boolean @default(false) @map("seller_suspended")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  authFactors AuthFactor[]
  sessions    Session[]

  @@index([createdAt])
  @@map("users")
}

/// One row per way a User can authenticate — password today; otp/social/passkey are
/// modeled (per backend/docs/00) but only "password" and "otp" are exercised this pass.
model AuthFactor {
  id     String @id @default(uuid())
  userId String @map("user_id")
  type   String // "password" | "otp" (MFA/social/passkey deferred — out of scope this pass)

  // Populated only for type = "password". Never populated for "otp".
  passwordHash String? @map("password_hash")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_factors")
}

/// Refresh-token tracking — one row per issued refresh token, enabling server-side
/// revocation (backend/docs/05: "a server-side revocation list so any session can be
/// force-terminated immediately").
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// OTP codes are Redis-backed (backend/src/modules/identity/domain/otp.service.ts), not a
// Postgres table — a 10-minute one-time code is transient session state, matching this
// file's own storage-topology note that Redis, not Postgres, owns that category of data.
// (Formerly modeled here as OtpCode / otp_codes; migrated off Postgres, not left stubbed.)

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String  @id @default(uuid())
  parentId    String? @map("parent_id")
  name        String
  slug        String  @unique
  countryCode String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  countryCode String @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  products Product[]

  @@map("brands")
}

model Product {
  id          String  @id @default(uuid())
  sellerId    String  @map("seller_id") // opaque reference to Identity's User — no @relation
  categoryId  String  @map("category_id")
  brandId     String? @map("brand_id")
  title       String
  slug        String  @unique
  description String?
  status      String  @default("draft") // draft | published | archived
  countryCode String  @default("SL") @map("country_code")

  // Merchandising flags — curated "featured"/"flash sale" views over Catalog's own
  // products, not a Marketing bounded-context extraction (backend/docs/00 explicitly
  // reserves Campaigns/flash-sales-the-concept for a not-yet-designed Marketing
  // context; these two booleans plus a filtered GET /products query are the deliberately
  // small, low-risk slice confirmed in scope instead — no campaignId/collectionId,
  // no Campaign/Collection models this pass).
  isFeatured  Boolean @default(false) @map("is_featured")
  isFlashSale Boolean @default(false) @map("is_flash_sale")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  // Full-text search (Batch B) — a Postgres GENERATED ALWAYS AS ... STORED column
  // over title+description, kept in sync by Postgres itself on every write, never
  // written to from application code. `Unsupported` because Prisma's schema DSL has
  // no first-class way to express a generated-column expression; the actual column
  // + GIN index are created by raw SQL in the migration (see
  // 20260810_add_product_search_vector). Excluded from Prisma's typed client by
  // design — queried via $queryRaw in CatalogService's search path.
  searchVector Unsupported("tsvector")? @map("search_vector")

  category   Category           @relation(fields: [categoryId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  variants   Variant[]
  attributes ProductAttribute[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([isFlashSale])
  @@map("products")
}

model Variant {
  id        String @id @default(uuid())
  productId String @map("product_id")
  sku       String @unique
  name      String // e.g. "Red / Large"

  priceAmount   Decimal @map("price_amount") @db.Decimal(14, 2)
  priceCurrency String  @map("price_currency") // Money — matches @nova/types CurrencyCode

  stockQuantity Int @default(0) @map("stock_quantity")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("variants")
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String @map("product_id")
  key       String
  value     String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_attributes")
}

// ============================================================
// WISHLIST
// One small bounded context of its own (owns its schema per backend/docs/00's
// ownership rule) rather than folded into Catalog or Identity — it references
// both Product/Variant (Catalog) and User (Identity) as opaque scalar columns,
// same no-cross-context-@relation convention as everywhere else in this file.
// ============================================================

/// One per user (enforced by the unique userId below) — created lazily on first
/// GET/POST rather than at signup, since most users never use it.
model Wishlist {
  id          String @id @default(uuid())
  userId      String @unique @map("user_id") // opaque reference to Identity's User
  countryCode String @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String  @id @default(uuid())
  wishlistId String  @map("wishlist_id")
  productId  String  @map("product_id") // opaque reference to Catalog's Product
  variantId  String? @map("variant_id") // opaque reference to Catalog's Variant — optional: a user can save a product in general, or a specific variant

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  wishlist Wishlist @relation(fields: [wishlistId], references: [id])

  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============================================================
// CART & CHECKOUT
// ============================================================

model Cart {
  id          String  @id @default(uuid())
  userId      String? @map("user_id") // opaque reference to Identity's User — null = guest
  guestToken  String? @unique @map("guest_token") // opaque token issued to guest sessions
  status      String  @default("active") // active | converted | abandoned
  countryCode String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  lines            CartLine[]
  checkoutSessions CheckoutSession[]

  @@index([userId])
  @@map("carts")
}

model CartLine {
  id        String @id @default(uuid())
  cartId    String @map("cart_id")
  variantId String @map("variant_id") // opaque reference to Catalog's Variant — no @relation
  quantity  Int

  // Price snapshot at add-time — re-confirmed against Catalog synchronously at checkout-session
  // creation (backend/docs/00: Cart & Checkout ↔ Catalog synchronous-call pattern), not re-read here.
  unitPriceAmount   Decimal @map("unit_price_amount") @db.Decimal(14, 2)
  unitPriceCurrency String  @map("unit_price_currency")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@map("cart_lines")
}

/// Existence and shape justified in backend/docs/00-bounded-contexts.md and 07-glossary.md:
/// distinct from Cart, created via POST /v1/checkout/session, consumed exactly once by
/// Orders' POST /v1/orders.
model CheckoutSession {
  id     String  @id @default(uuid())
  cartId String  @map("cart_id")
  userId String? @map("user_id") // opaque reference to Identity's User

  addressLine    String @map("address_line")
  city           String
  district       String
  phone          String
  deliveryMethod String @map("delivery_method") // standard | express | pickup
  paymentMethod  String @map("payment_method") // wallet | card | mobile-money

  subtotalAmount   Decimal @map("subtotal_amount") @db.Decimal(14, 2)
  subtotalCurrency String  @map("subtotal_currency")

  // Stubbed pending Logistics/Marketing (backend/docs/00-bounded-contexts.md) — see
  // backend/src/modules/cart-checkout/domain/pricing/. promoCode is null when none was
  // submitted; discountAmount/shippingFeeAmount default to 0.00 so total = subtotal for
  // every pre-existing row and every checkout that doesn't use these yet.
  promoCode         String? @map("promo_code")
  discountAmount    Decimal @default(0.00) @map("discount_amount") @db.Decimal(14, 2)
  shippingFeeAmount Decimal @default(0.00) @map("shipping_fee_amount") @db.Decimal(14, 2)

  totalAmount   Decimal @map("total_amount") @db.Decimal(14, 2)
  totalCurrency String  @map("total_currency")

  status     String    @default("pending") // pending | consumed | expired
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@index([status])
  @@map("checkout_sessions")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                String  @id @default(uuid())
  checkoutSessionId String  @unique @map("checkout_session_id") // opaque ref to Cart & Checkout
  userId            String? @map("user_id") // opaque reference to Identity's User

  status String @default("placed") // placed|confirmed|packed|shipped|delivered|completed|cancelled|returned

  totalAmount   Decimal @map("total_amount") @db.Decimal(14, 2)
  totalCurrency String  @map("total_currency")
  countryCode   String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  subOrders SubOrder[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model SubOrder {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  sellerId String @map("seller_id") // opaque reference to Identity's User

  status String @default("placed")

  subtotalAmount   Decimal @map("subtotal_amount") @db.Decimal(14, 2)
  subtotalCurrency String  @map("subtotal_currency")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("sub_orders")
}

/// The outbox — backend/docs/04-events-and-jobs.md's proposed schema, implemented now
/// per this task's explicit instruction even though no consumer exists yet.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attempts      Int       @default(0)

  @@index([occurredAt])
  @@map("outbox_events")
}

// ============================================================
// NOTIFICATIONS (Batch B)
// In-app only this pass — push/email/SMS delivery is stubbed exactly like OTP was
// (logged in development, // TODO: wire real provider). Rows are created by the
// outbox relay (common/outbox/) consuming OutboxEvent, never by Orders/Payments
// writing here directly — that would be the exact cross-module table write
// backend/docs/00's ownership rule prohibits.
// ============================================================

model Notification {
  id            String  @id @default(uuid())
  userId        String  @map("user_id") // opaque reference to Identity's User
  type          String // controlled vocabulary, e.g. "order.placed", "refund.rejected"
  title         String
  body          String
  referenceType String? @map("reference_type") // e.g. "Order", "RefundRequest"
  referenceId   String? @map("reference_id")
  readAt        DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Generic idempotency-key dedupe store (backend/docs/02-api-standards.md). Scoped here
/// rather than as shared cross-cutting infrastructure because Orders' POST /v1/orders is
/// the only idempotent endpoint this pass — extract it if a second consumer needs it.
model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @map("key")
  endpoint     String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([key, endpoint])
  @@map("idempotency_keys")
}

// ============================================================
// AUDIT LOG (cross-cutting)
// ============================================================

/// Vol 3, E1's audit logging standard, stood up now rather than deferred with the rest
/// of Trust & Safety (backend/docs/05-security-baseline.md's proposed resolution to the
/// "Phase 1 writes to a Phase 2+ context's table" tension): every module gets a thin,
/// synchronous AuditLogger (backend/src/common/audit/) that writes here directly, so
/// Trust & Safety inherits an already-populated table instead of retrofitting one.
/// "Audit records can never be edited or deleted through any application code path" —
/// enforced by convention (no update/delete call site exists anywhere in this codebase),
/// not by a database trigger in this pass.
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id") // null = unauthenticated/system-initiated action
  action        String // controlled vocabulary, e.g. "user.login", "product.create"
  targetType    String   @map("target_type") // e.g. "User", "Product", "Order"
  targetId      String?  @map("target_id")
  reason        String? // required by the caller for sensitive ops; optional at the schema level
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz // server-generated, never client-supplied
  ipAddress     String?  @map("ip_address")
  correlationId String   @map("correlation_id")

  @@index([actorId])
  @@index([action])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ============================================================
// PAYMENTS & WALLET (Phase 2 — backend/docs/09-payments-wallet-design.md)
// Settlement/SellerPayout are Finance's entities — see LOGISTICS/FINANCE/TRUST & SAFETY
// below (backend/docs/10). Logistics' CODReconciliation is still not built anywhere —
// see that design doc's Scope section for why.
// ============================================================

model WalletAccount {
  id          String @id @default(uuid())
  ownerId     String @map("owner_id") // opaque reference to Identity's User (customer or seller)
  ownerType   String @map("owner_type") // "customer" | "seller"
  currency    String
  countryCode String @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  ledgerEntries WalletLedgerEntry[]

  @@unique([ownerId, currency])
  @@index([ownerId])
  @@map("wallet_accounts")
}

/// Append-only — balances are always SUM(amount), never a mutable column (Vol 2, D2 /
/// Vol 5, C1). "amount" is signed: positive = credit, negative = debit.
model WalletLedgerEntry {
  id              String  @id @default(uuid())
  walletAccountId String  @map("wallet_account_id")
  amount          Decimal @map("amount") @db.Decimal(14, 2)
  currency        String
  type            String // "refund_credit" | "checkout_debit" | "store_credit" | "cashback"
  referenceType   String? @map("reference_type") // e.g. "Order", "RefundRequest"
  referenceId     String? @map("reference_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id])

  @@index([walletAccountId])
  @@index([referenceType, referenceId])
  @@map("wallet_ledger_entries")
}

/// One per Order (created in the same transaction as the Order — backend/docs/09).
/// providerReference is populated only once a real PSP adapter exists; the stub adapter
/// never sets it.
model PaymentIntent {
  id                String  @id @default(uuid())
  orderId           String  @unique @map("order_id") // opaque reference to Orders
  userId            String? @map("user_id") // opaque reference to Identity's User
  method            String // "orange_money" | "afrimoney" | "card" | "wallet" | "cod"
  status            String  @default("pending") // pending|processing|succeeded|failed|refunded
  amount            Decimal @map("amount") @db.Decimal(14, 2)
  currency          String
  providerReference String? @map("provider_reference")
  countryCode       String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  @@index([orderId])
  @@index([status])
  @@map("payment_intents")
}

/// Vol 3, B4 dual authorization, made real for the first time in this codebase: a
/// refund above the configured threshold needs a second, different approver before the
/// wallet credit executes. proposedBy and approvedBy are opaque User references —
/// enforced-different at the service layer (backend/docs/09), not by a DB constraint
/// (Postgres can't easily express "these two columns must differ" as a CHECK against
/// two nullable-until-approved columns without extra complexity this pass doesn't need).
model RefundRequest {
  id              String  @id @default(uuid())
  paymentIntentId String  @map("payment_intent_id")
  amount          Decimal @map("amount") @db.Decimal(14, 2)
  currency        String
  reason          String
  status          String  @default("proposed") // proposed|approved|rejected|executed
  proposedBy      String  @map("proposed_by")
  approvedBy      String? @map("approved_by")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([paymentIntentId])
  @@index([status])
  @@map("refund_requests")
}

// ============================================================
// LOGISTICS (Phase 2 — backend/docs/10-logistics-finance-trust-safety-design.md)
// CODReconciliation is not built here — no COD payment method exists to reconcile
// against (same reasoning as Payments & Wallet's COD deferral). Dispatch/routing
// algorithms are out of scope — DeliveryJob assignment is an explicit admin action.
// ============================================================

/// Admin-managed, starts empty — no per-district rate is seeded with an invented
/// number. CheckoutService's LogisticsFeeZoneLookup falls back to flat defaults when
/// no zone matches a district (backend/docs/10).
model DeliveryZone {
  id                String  @id @default(uuid())
  district          String  @unique
  standardFeeAmount Decimal @map("standard_fee_amount") @db.Decimal(14, 2)
  expressFeeAmount  Decimal @map("express_fee_amount") @db.Decimal(14, 2)
  currency          String
  countryCode       String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  deliveryJobs DeliveryJob[]

  @@index([district])
  @@map("delivery_zones")
}

/// subOrderId/riderId are opaque references (Orders/Identity own those tables — Vol 2,
/// B1's "no other module reads or writes another module's tables directly"). Created
/// only by an explicit assignment call, never automatically from OrderPlaced (Vol 5,
/// Part E's dispatch/routing isn't specified in enough detail to automate — see the
/// design doc).
model DeliveryJob {
  id             String  @id @default(uuid())
  subOrderId     String  @unique @map("sub_order_id")
  riderId        String  @map("rider_id")
  deliveryZoneId String? @map("delivery_zone_id")
  status         String  @default("assigned") // assigned|picked_up|in_transit|delivered|failed
  countryCode    String  @default("SL") @map("country_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  deliveryZone     DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id])
  proofOfDelivery  ProofOfDelivery?

  @@index([riderId])
  @@index([status])
  @@map("delivery_jobs")
}

/// One per successfully delivered DeliveryJob — created on the delivered transition.
model ProofOfDelivery {
  id             String  @id @default(uuid())
  deliveryJobId  String  @unique @map("delivery_job_id")
  recipientName  String  @map("recipient_name")
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveryJob DeliveryJob @relation(fields: [deliveryJobId], references: [id])

  @@map("proofs_of_delivery")
}

// ============================================================
// FINANCE (Phase 2 — backend/docs/10-logistics-finance-trust-safety-design.md)
// Chart of accounts is minimal and code-defined (seller_payable, platform_cash) — no
// revenue/commission/tax accounts, because nothing in this pass posts to them (no
// commission math exists anywhere yet — see the design doc's Scope Boundary note).
// ============================================================

model LedgerAccount {
  id       String @id @default(uuid())
  code     String @unique // "seller_payable" | "platform_cash"
  name     String
  currency String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

/// Append-only double-entry — every SellerPayout execution posts a balanced pair
/// (debitAmount on one row, creditAmount on the other, same amount, same currency).
/// One of debitAmount/creditAmount is always 0.00 on a given row (the standard
/// T-account representation) — never both nonzero, never negative.
model LedgerEntry {
  id              String  @id @default(uuid())
  ledgerAccountId String  @map("ledger_account_id")
  debitAmount     Decimal @default(0.00) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount    Decimal @default(0.00) @map("credit_amount") @db.Decimal(14, 2)
  currency        String
  referenceType   String  @map("reference_type") // e.g. "SellerPayout"
  referenceId     String  @map("reference_id")
  description     String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([ledgerAccountId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

/// Vol 3, B4 dual authorization — mirrors RefundRequest exactly (backend/docs/10).
/// sellerId is an opaque reference to Identity's User. amount is proposer-supplied,
/// not derived from any computed "available balance" — see the design doc's Scope
/// Boundary note for why that calculation doesn't exist yet.
model SellerPayout {
  id              String  @id @default(uuid())
  sellerId        String  @map("seller_id")
  amount          Decimal @map("amount") @db.Decimal(14, 2)
  currency        String
  reason          String
  status          String  @default("proposed") // proposed|approved|rejected|executed
  proposedBy      String  @map("proposed_by")
  approvedBy      String? @map("approved_by")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([sellerId])
  @@index([status])
  @@map("seller_payouts")
}

// ============================================================
// TRUST & SAFETY (Phase 2 — backend/docs/10-logistics-finance-trust-safety-design.md)
// AuditLog already exists (Phase 1 — backend/docs/05-security-baseline.md). Fraud
// scoring, velocity checks, and the human review queue remain deferred.
// ============================================================

/// Vol 3, B4's "seller approval" made real. documentReference is a plain string — a
/// stubbed integration point (no OCR/third-party verification), same posture as the
/// OTP and PSP stubs. Dual-authorized with NO threshold exception (unlike refunds/
/// payouts) — Vol 3, B4 names seller approval/suspension without a value qualifier.
model KYCSubmission {
  id                 String  @id @default(uuid())
  subjectId          String  @map("subject_id") // opaque reference to Identity's User
  subjectType        String  @map("subject_type") // "seller" | "rider"
  documentReference  String  @map("document_reference")
  status             String  @default("pending") // pending|approved|rejected
  reviewProposedBy   String? @map("review_proposed_by")
  proposedDecision   String? @map("proposed_decision") // "approve" | "reject"
  reviewConfirmedBy  String? @map("review_confirmed_by")
  rejectionReason    String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([subjectId])
  @@index([status])
  @@map("kyc_submissions")
}

/// Exactly one of orderId/reviewId is set — enforced at the service layer (same
/// reasoning as RefundRequest's proposedBy != approvedBy: not easily a DB CHECK
/// across two nullable columns without more complexity than this pass needs).
model Dispute {
  id       String  @id @default(uuid())
  orderId  String? @map("order_id") // opaque reference to Orders
  reviewId String? @map("review_id") // opaque reference to Catalog
  openedBy String  @map("opened_by") // opaque reference to Identity's User
  reason   String
  status   String  @default("open") // open|resolved|closed
  resolution String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  events DisputeEvent[]

  @@index([orderId])
  @@index([reviewId])
  @@index([status])
  @@map("disputes")
}

/// Append-only timeline — same shape as AuditLog/WalletLedgerEntry, applied to a
/// non-financial domain. No update/delete method exists on it anywhere in this module.
model DisputeEvent {
  id        String  @id @default(uuid())
  disputeId String  @map("dispute_id")
  actorId   String  @map("actor_id") // opaque reference to Identity's User
  eventType String  @map("event_type") // "opened" | "comment" | "status_changed" | "resolved"
  note      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("dispute_events")
}

/// The other half of Vol 3, B4's "seller approval/suspension" — same dual-auth shape as
/// KYCSubmission and RefundRequest, no threshold exception. Writes to User.sellerSuspended
/// go through IdentityPublicService.setSellerSuspended() on execution, never a direct
/// cross-module table write (backend/docs/10).
model SellerSuspensionRequest {
  id              String  @id @default(uuid())
  sellerId        String  @map("seller_id") // opaque reference to Identity's User
  action          String // "suspend" | "reinstate"
  reason          String
  status          String  @default("proposed") // proposed|approved|rejected|executed
  proposedBy      String  @map("proposed_by")
  approvedBy      String? @map("approved_by")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([sellerId])
  @@index([status])
  @@map("seller_suspension_requests")
}
