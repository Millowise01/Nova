{
  "name": "@nova/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./charts": "./src/charts.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@nova/design-system": "workspace:*",
    "@nova/utils": "workspace:*",
    "react": "^19.3.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "storybook": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.4",
    "eslint-plugin-storybook": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "vite": "^7.0.0",
    "@storybook/addon-docs": "^10.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "clean": "rimraf dist coverage storybook-static"
