{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "declarationMap": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../design-system"
    },
    {
      "path": "../utils"
    }
  ],
  "exclude": ["node_modules", "dist"]
}
