{
  "name": "@nova/design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css/variables.css",
    "./css/variables.css": "./src/css/variables.css",
    "./css/tokens.css": "./src/css/variables.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist coverage storybook-static"
  },
  "dependencies": {
    "@nova/icons": "workspace:*",
    "@nova/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.542.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "storybook": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.4"
  }
}
