{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "declarationMap": true
  },
  "include": ["src"],
  "references": [
    { "path": "../api-client" },
    { "path": "../auth" },
    { "path": "../ui" },
    { "path": "../validation" }
  ],
  "exclude": ["node_modules", "dist"]
}
